{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "graph",
  "version": "1.0.2",
  "description": "Dependency graph execution through OpenAgent checkpoints.",
  "license": "MIT",
  "repository": "https://github.com/BANG404/openagent-graph",
  "keywords": ["openagent", "graph", "goal", "checkpoint"],
  "extensions": {
    "openagent": {
      "runtime": "graph",
      "capabilities": ["flow", "mcp", "checkpoint", "parallel-execution"],
      "flows": [
        {
          "id": "graph",
          "label": "Graph",
          "description": "Execute dependency-aware graph nodes.",
          "argument": "required_text",
          "step": "bin/graph-step.mjs",
          "timeout_secs": 60,
          "max_iterations": 50
        }
      ]
    }
  }
}
